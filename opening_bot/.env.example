###############################################
# 🔑 API / Endpoints
###############################################
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_API_KEY=YOUR_KEY
BINANCE_API_SECRET=YOUR_KEY

###############################################
# ⚙️ Behavior
###############################################
DRY_RUN=true              # true = no envía órdenes reales
DEFAULT_LEVERAGE=10       # apalancamiento por defecto

###############################################
# 🔍 Scanning
###############################################
SCAN_INTERVAL_SEC=60      # cada cuántos segundos escanea
KLINE_INTERVAL=1h        # velas a usar (ej: 15m, 1h)
DAYS_LOOKBACK=3           # días de histórico a mirar

###############################################
# 💰 Risk & Capacity
###############################################
MARGIN_PCT=0.025          # 2.5% del equity por orden
MAX_ACTIVE_SLOTS=10       # máximo posiciones+órdenes
MIN_LISTING_AGE_DAYS=7    # no tradear listados <7 días

###############################################
# 🎯 Filters / Signal Params
###############################################
MIN_24H_USDT_VOLUME=10000000   # mínimo volumen 24h
MIN_ATR_PCT=0.5                # mínimo ATR% (volatilidad)
NEAR_LEVEL_PCT=20            # proximidad al high/low %
OFFSET_FROM_LEVEL_PCT=0.05     # alejar orden del nivel %
STOP_BUFFER_PCT=0.05           # SL antes del precio liquidación %
MAX_ORDER_AGE_HOURS=1         # cancelar órdenes viejas
COOLDOWN_HOURS=24             # tiempo de espera para volver a abrir una orden en un simbolo
RANGE_EXCLUDE_RECENT_BARS=4    # excluir últimas N velas para rango (evitar tendencias)

###############################################
# 🎯 SL near Liq price
###############################################
# STOP_NEAR_LIQ_BUFFER_PCT=0.5 # percentage close to Liq price
# STOP_WORKING_TYPE=MARK_PRICE # recomendado MARK_PRICE
# STOPS_CHECK_INTERVAL_SEC= # cada cuánto revisar stops protectores (segundos)
# STOPS_RETRY_COOLDOWN_SEC=  # evita reintentos muy seguidos por símbolo si falló colocar stop (segundos)


###############################################
# 🌌 Universe
###############################################
UNIVERSE_SIZE=40
# SYMBOLS_WHITELIST=             # lista fija (ej: BTCUSDT,ETHUSDT)
# SYMBOLS_BLACKLIST= # lista negra (ej: BNBUSDT,AVAXUSDT)

###############################################
# ⏰ Time Window (UTC-6 fijo)
###############################################
TZ_OFFSET_HOURS=6              # UTC-6
WINDOW_START=00:00
WINDOW_END=23:00

###############################################
# 🚦 Requests Limit Control
###############################################
MAX_RETRIES=4
BASE_BACKOFF=0.5
BACKOFF_JITTER=0.4
PAUSE_THRESHOLD_USED_WEIGHT=1000
PAUSE_SECONDS_WHEN_NEAR=3.0
PER_SYMBOL_DELAY_MIN=0.1
PER_SYMBOL_DELAY_MAX=0.25

###############################################
# 📂 Files
###############################################
STATE_PATH=state.json

###############################################
# 🐞 Verbosity / Debug
###############################################
VERBOSE=true
SYMBOL_LOG_LIMIT=0    # 0 is no limit